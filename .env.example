# Public SaaS frontend configuration
# These values are public Vite env vars only. Never put API secrets here.

# Supabase Auth (required for login/signup/session)
# See SUPABASE_SETUP.md
# Electron production builds require these at vite build time (inlined into dist).
# Prefer committed .env.production (public Vite vars only) or:
#   npm run env:pull:production
#   npm run env:resolve:supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Affects UI copy only — does not send real email from this frontend.
VITE_EMAIL_PROVIDER_ENABLED=false

# DEV ONLY — force browser localStorage mockApi. Never set in production.
# VITE_USE_MOCK_API=true

# Optional OAuth redirect entry points. Require a secure backend/provider.
# VITE_GOOGLE_OAUTH_URL=
# VITE_MICROSOFT_OAUTH_URL=
# VITE_APPLE_OAUTH_URL=

# ---------------------------------------------------------------------------
# Server-only (set in Vercel Environment Variables — NEVER prefix with VITE_)
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=

# Permanent owner bootstrap (required if /api/ensure-permanent-owner creates users)
# PERMANENT_COMPANY_OWNER_PASSWORD=
# PERMANENT_PLATFORM_ADMIN_PASSWORD=
# ENSURE_OWNER_SECRET=          # min 16 chars; required in production for ensure-permanent-owner
# ENSURE_OWNER_REQUIRE_SECRET=true

# Zoho SMTP (preferred for verification / owner email change)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@httpsnexorapos.com
# SMTP_PASS=
# SMTP_FROM=Nexora POS <noreply@httpsnexorapos.com>

# Optional fallback if Zoho SMTP is not set
# RESEND_API_KEY=

# SMS OTP via Africa's Talking (registration / login verification / password reset).
# Falls back to email automatically if unset or a send fails.
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=        # optional registered short code / alphanumeric sender
# AFRICASTALKING_ENV=sandbox       # optional — force the AT sandbox endpoint

# Secret used to HMAC-hash OTP codes and sign reset/enrollment tickets.
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset — set a dedicated value in production.
# OTP_HASH_SECRET=
