{
  "name": "nexora-pos-enterprise",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Nexora POS Pro — production web application for retail POS, inventory, and reporting",
  "author": "Nexora Retail Systems",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings=99999",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "test:auth-logic": "node scripts/auth-logic-test.mjs",
    "test:owner-email": "node scripts/owner-email-flow-test.mjs",
    "test:receipt-codes": "node scripts/receipt-codes-test.mjs",
    "test:feature-smoke": "node scripts/feature-smoke.mjs",
    "test:runtime-api": "node scripts/runtime-api-smoke.mjs",
    "test:purchase-approve": "node scripts/purchase-approve-e2e-test.mjs",
    "test:purchase-receive": "node scripts/purchase-receive-e2e-test.mjs",
    "test:purchase-guard": "node scripts/purchase-receive-guard-test.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:company-management": "node scripts/verify-company-management.mjs",
    "verify:production": "node scripts/production-verification.mjs",
    "deploy": "node scripts/deploy.mjs",
    "electron": "electron ./electron/main.cjs",
    "electron:dev": "electron ./electron/main.cjs --dev",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.nexorapos.app",
    "productName": "Nexora POS Pro",
    "directories": {
      "output": "release/dist"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.110.7",
    "africastalking": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "canvg": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "framer-motion": "^11.18.2",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.383.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "resend": "^6.17.2",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "playwright": "^1.62.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5"
  }
}
